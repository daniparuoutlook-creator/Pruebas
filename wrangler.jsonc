{
  "name": "web",
  "main": "worker.js",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // Máximo 10 mensajes por minuto y por IP al asistente.
  "ratelimits": [
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "vars": {
    // Opcional: otros orígenes que puedan usar el chat (p. ej. tu dominio propio cuando lo tengas).
    "ALLOWED_ORIGINS": ""
  },
  "observability": { "enabled": true }
}
